    "description": "Six people. Six weeks. The questions that don't leave you alone.",
    "provider": {
      "@type": "Person",
      "name": "Chris McCann",
      "url": "https://chrismccann.co"
    }
  }
  </script>
  <style>
    main.retreat-layout { display: grid; grid-template-columns: 1fr 260px; gap: 4rem; max-width: 940px; padding: 0 2rem; margin: 0 auto; align-items: start; }
    .retreat-sidebar { display: flex; flex-direction: column; gap: 1.25rem; position: sticky; top: 5rem; }
    .retreat-box { background: #ffffff; border: 1px solid var(--light-gray); padding: 1.6rem 1.5rem; }
    .retreat-box-label { font-family: var(--sans); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #8C4733; margin-bottom: 1rem; }
    .retreat-box-headline { font-family: var(--serif); font-size: 1rem; line-height: 1.6; margin-bottom: 0 !important; max-width: none; }
    .retreat-box-divider { border: none; border-top: 1px solid var(--light-gray); margin: 1.1rem 0; }
    .retreat-box-list { list-style: none; padding: 0; margin: 0; }
    .retreat-box-list li { font-family: var(--sans); font-size: 0.78rem; color: var(--gray); padding: 0.22rem 0; letter-spacing: 0.02em; display: flex; gap: 0.5rem; }
    .retreat-box-list li::before { content: '—'; color: var(--gray); flex-shrink: 0; }
    .retreat-testimonials { max-width: 940px; margin: 0 auto; padding: 3rem 2rem; border-top: 1px solid var(--light-gray); border-bottom: 1px solid var(--light-gray); text-align: center; }
    .retreat-testimonials blockquote { margin: 0; padding: 0; }
    .retreat-testimonials .t-featured p { font-family: var(--serif); font-size: 1.55rem; font-style: italic; line-height: 1.5; max-width: 600px; margin: 0 auto; color: var(--black); }
    .retreat-testimonials .t-featured cite { display: block; font-family: var(--sans); font-style: normal; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); margin-top: 1rem; }
    .retreat-testimonials .t-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--light-gray); }
    .retreat-testimonials .t-small p { font-family: var(--serif); font-size: 1rem; font-style: italic; line-height: 1.65; color: var(--black); margin: 0; }
    .retreat-testimonials .t-small cite { display: block; font-family: var(--sans); font-style: normal; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gray); margin-top: 0.85rem; }
    @media (max-width: 768px) { main.retreat-layout { grid-template-columns: 1fr; gap: 2.5rem; } .retreat-sidebar { position: static; order: -1; } .retreat-testimonials .t-grid { grid-template-columns: 1fr; gap: 2rem; } }
