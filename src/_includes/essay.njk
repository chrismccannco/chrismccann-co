---
ogType: article
---
{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "url": "{{ site.siteUrl }}{{ permalink }}",
  "image": "{{ site.defaultOgImage }}",
  "author": { "@type": "Person", "name": "{{ site.author }}", "url": "{{ site.siteUrl }}" },
  "publisher": { "@type": "Person", "name": "{{ site.author }}", "url": "{{ site.siteUrl }}" },
  "isPartOf": { "@type": "Blog", "name": "Field Notes", "url": "{{ site.siteUrl }}/field-notes" },
  "datePublished": "{{ date | isoDate }}",
  "mainEntityOfPage": "{{ site.siteUrl }}{{ permalink }}"
}
</script>
{% endblock %}

{% block pagestyle %}
<style>
  .article-ph { max-width: 720px; margin: 0 auto; padding: 80px var(--px) 48px; }
  .article-ph .ph-eye { margin-bottom: 20px; }
  .article-ph .ph-title { font-size: 46px; }
  hr.article-rule { border: none; border-top: 1px solid var(--ink); max-width: 720px; margin: 0 auto; }
  .article-prose { max-width: 720px; margin: 0 auto; padding: 48px var(--px) 0; }
  .article-prose p { font-size: 20px; line-height: 1.8; color: var(--muted); margin-bottom: 24px; text-wrap: pretty; }
  .article-prose p:last-child { margin-bottom: 0; }
  .article-prose a { color: var(--ink); border-bottom: 1px solid var(--line2); transition: border-color .15s; }
  .article-prose a:hover { border-bottom-color: var(--ink); }
  .article-foot { max-width: 720px; margin: 0 auto; padding: 40px var(--px) 0; }
  .article-callout { font-size: 18px; font-style: italic; color: var(--muted); line-height: 1.7; margin-bottom: 12px; }
  .article-callout-link { font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: .1em; color: var(--rust); }
  .article-back { max-width: 720px; margin: 0 auto; padding: 32px var(--px) 80px; }
  .article-back a { font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); transition: color .15s; }
  .article-back a:hover { color: var(--ink); }
  .related { max-width: 720px; margin: 0 auto; padding: 0 var(--px) 32px; border-top: 1px solid var(--line); padding-top: 32px; }
  .related h3 { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--faint); margin-bottom: 16px; }
  .related ul { list-style: none; }
  .related li { margin-bottom: 10px; }
  .related a { color: var(--ink); border-bottom: 1px solid var(--line2); font-size: 16px; }
  .related a:hover { border-bottom-color: var(--ink); }
  @media (max-width: 860px) {
    .article-ph { padding: 56px var(--px) 40px; }
    .article-ph .ph-title { font-size: 32px; }
    .article-prose p { font-size: 18px; }
  }
</style>
{% endblock %}

{% block content %}
<article>
  <div class="ph article-ph">
    <div class="ph-eye">{{ date | dateDisplay }}</div>
    <h1 class="ph-title">{{ title }}</h1>
  </div>
  <hr class="ph-rule article-rule">

  <div class="article-prose">
    {{ content | safe }}
  </div>

  <div class="article-foot">
    <p class="article-callout">{{ assessmentCallout if assessmentCallout else "The Field Assessment asks eighteen questions the quarterly review won't." }}</p>
    <a class="article-callout-link" href="/field-assessment/">TAKE THE FIELD ASSESSMENT &rarr;</a>
  </div>

  {% if relatedReading %}
  <div class="related">
    <h3>Related Reading</h3>
    <ul>
      {% for item in relatedReading %}
      <li><a href="{{ item.url }}">{{ item.title }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <div class="article-back">
    <a href="/field-notes/">&larr; All Field Notes</a>
  </div>
</article>
{% endblock %}

{% block subscribe %}
<div class="sub-band">
  <div class="sub-band-inner">
    <h2>Field Notes Newsletter</h2>
    <p>The room shifts when you walk in. You know this. Twice a month.</p>
    <form class="sub-form" id="subBandForm" novalidate>
      <input type="email" id="bandEmail" placeholder="you@work.com" aria-label="Email address" required>
      <button type="submit" id="bandBtn">I&rsquo;M IN</button>
    </form>
    <div class="sub-success" id="bandSuccess">You&rsquo;re in. Check your inbox.</div>
    <div class="sub-error" id="bandError">Something went wrong &mdash; try again.</div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('subBandForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email = document.getElementById('bandEmail').value.trim();
  const btn = document.getElementById('bandBtn');
  if (!email) return;
  btn.textContent = '...';
  btn.disabled = true;
  try {
    const res = await fetch('/.netlify/functions/subscribe', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email })
    });
    if (res.ok) {
      document.getElementById('subBandForm').style.display = 'none';
      document.getElementById('bandSuccess').style.display = 'block';
    } else {
      document.getElementById('bandError').style.display = 'block';
      btn.textContent = 'I’M IN'; btn.disabled = false;
    }
  } catch (err) {
    document.getElementById('bandError').style.display = 'block';
    btn.textContent = 'I’M IN'; btn.disabled = false;
  }
});
</script>
{% endblock %}
