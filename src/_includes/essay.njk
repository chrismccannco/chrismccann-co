---
ogType: article
---
{% extends "base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "url": "{{ site.siteUrl }}{{ permalink }}",
  "image": "{{ site.defaultOgImage }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.siteUrl }}"
  },
  "publisher": {
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "{{ site.siteUrl }}"
  },
  "isPartOf": {
    "@type": "Blog",
    "name": "Field Notes",
    "url": "{{ site.siteUrl }}/field-notes"
  },
  "datePublished": "{{ date | isoDate }}",
  "mainEntityOfPage": "{{ site.siteUrl }}{{ permalink }}"
}
</script>
{% endblock %}

{% block header %}
{% endblock %}

{% block content %}
<article id="main-content" class="fade-in">
  <header class="article-header">
    <div class="article-meta">{{ date | dateDisplay }}</div>
    <h1 class="article-title">{{ title }}</h1>
  </header>
  <div class="article-body">
    {{ content | safe }}
  </div>
  <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #e8e6e2;">
    <p style="font-style: italic; color: #666; font-size: 1.05rem; line-height: 1.7;">{{ assessmentCallout if assessmentCallout else "The Field Assessment asks eighteen questions the quarterly review won't." }}</p>
    <p style="margin-top: 0.5rem;"><a class="inline-link" href="/field-assessment/">Take the Field Assessment &rarr;</a></p>
  </div>
</article>

<div class="article-nav fade-in">
  <a href="/field-notes/" class="back-link">&larr; All Field Notes</a>
</div>

{% if relatedReading %}
<div class="related-reading" style="max-width: var(--max-w); margin: 2.5rem auto; padding: 1.5rem 2rem; border-top: 1px solid var(--border, #e8e4de);">
  <h3 style="font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary, #888); margin-bottom: 1rem; font-weight: 500;">Related Reading</h3>
  <ul style="list-style: none; padding: 0; margin: 0;">
    {% for item in relatedReading %}
    <li style="margin-bottom: 0.5rem;"><a href="{{ item.url }}" style="text-decoration: none; color: inherit; border-bottom: 1px solid var(--border, #e8e4de);">{{ item.title }}</a></li>
    {% endfor %}
  </ul>
</div>
{% endif %}
{% endblock %}

{% block subscribe %}
<div id="signup" class="signup-section fade-in">
  <h2 style="font-family: var(--sans); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.5rem;">Field Notes</h2>
  <p style="font-family: var(--serif); font-size: 16px; color: rgba(255,255,255,0.9); margin-bottom: 0.35rem; max-width: 420px; margin-left: auto; margin-right: auto; line-height: 1.6;">The room shifts when you walk in. You know this.</p>
  <p style="font-family: var(--serif); font-size: 14px; font-style: italic; color: rgba(255,255,255,0.6); margin-bottom: 1.5rem; max-width: 420px; margin-left: auto; margin-right: auto;">Twice a month.</p>
  <form id="pageSubscribe" style="display: inline-flex; gap: 0; max-width: 380px; width: 100%;">
    <input type="email" id="pageEmail" required placeholder="Your email" aria-label="Email address"
      style="flex: 1; padding: 10px 14px; font-family: var(--sans); font-size: 0.85rem; border: 1px solid var(--light-gray); border-right: none; background: #fff; color: var(--black); outline: none; min-width: 0;">
    <button type="submit" id="pageSubBtn"
      style="padding: 10px 20px; font-family: var(--sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; background: var(--black); color: var(--white); border: 1px solid var(--black); cursor: pointer; white-space: nowrap; transition: opacity 0.2s;">Subscribe</button>
  </form>
  <div id="pageSubSuccess" style="display: none; font-family: var(--sans); font-size: 0.85rem; color: var(--accent); margin-top: 0.5rem;">You&rsquo;re in. Check your inbox.</div>
  <div id="pageSubError" style="display: none; font-family: var(--sans); font-size: 0.85rem; color: #c0392b; margin-top: 0.5rem;">Something went wrong. Try again.</div>
  <script>
  document.getElementById('pageSubscribe').addEventListener('submit', async function(e) {
    e.preventDefault();
    const email = document.getElementById('pageEmail').value.trim();
    const btn = document.getElementById('pageSubBtn');
    if (!email) return;
    btn.textContent = '...';
    btn.disabled = true;
    try {
      const res = await fetch('/.netlify/functions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email })
      });
      if (res.ok) {
        document.getElementById('pageSubscribe').style.display = 'none';
        document.getElementById('pageSubSuccess').style.display = 'block';
      } else {
        document.getElementById('pageSubError').style.display = 'block';
        btn.textContent = 'Subscribe';
        btn.disabled = false;
      }
    } catch (err) {
      document.getElementById('pageSubError').style.display = 'block';
      btn.textContent = 'Subscribe';
      btn.disabled = false;
    }
  });
  </script>
</div>

<div class="divider"><span class="colophon"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg"><rect x="6" y="0" width="8.49" height="8.49" rx="1" transform="rotate(45 6 0)" fill="none" stroke="#ccc" stroke-width="1"/></svg></span></div>
{% endblock %}
