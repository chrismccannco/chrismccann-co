---
title: "Subscribe — Field Notes"
description: "Field Notes by Chris McCann. Consciousness, leadership, and the gap between them. Two essays a month."
permalink: /subscribe/index.html
---
{%- extends "base.njk" -%}

{%- block head -%}
<style>
  .subscribe-wrap { max-width: 480px; margin: 0 auto; padding: 4rem 2rem 5rem; text-align: center; }
  .subscribe-mark { font-family: var(--sans); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.25rem; }
  .subscribe-tagline { font-family: var(--serif); font-size: 1.2rem; font-style: italic; color: var(--gray); line-height: 1.6; margin-bottom: 2.5rem; }
  .subscribe-form { display: flex; gap: 0; max-width: 380px; width: 100%; margin: 0 auto 1rem; }
  .subscribe-input { flex: 1; padding: 13px 16px; font-family: var(--sans); font-size: 0.9rem; border: 1px solid var(--light-gray); border-right: none; background: #fff; color: var(--black); outline: none; min-width: 0; transition: border-color 0.2s ease; }
  .subscribe-input:focus { border-color: var(--accent); }
  .subscribe-btn { padding: 13px 24px; font-family: var(--sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; background: var(--black); color: var(--white); border: 1px solid var(--black); cursor: pointer; white-space: nowrap; transition: opacity 0.2s ease; }
  .subscribe-btn:hover { opacity: 0.8; }
  .subscribe-success { font-family: var(--sans); font-size: 0.85rem; color: var(--accent); margin-top: 0.75rem; display: none; }
  .subscribe-error { font-family: var(--sans); font-size: 0.85rem; color: #c0392b; margin-top: 0.75rem; display: none; }
  .subscribe-recent { max-width: 480px; margin: 0 auto; padding: 0 2rem 3rem; text-align: left; }
  .subscribe-recent-label { font-family: var(--sans); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gray); margin-bottom: 1.25rem; padding-top: 2rem; border-top: 1px solid var(--light-gray); }
  .subscribe-recent-item { margin-bottom: 0.9rem; }
  .subscribe-recent-item a { font-family: var(--serif); font-size: 1.05rem; font-style: italic; color: var(--black); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s ease; }
  .subscribe-recent-item a:hover { border-bottom-color: var(--accent); }
  .subscribe-recent-arrow { color: var(--gray); margin-right: 0.5rem; font-style: normal; }
</style>
{%- endblock -%}

{%- block header -%}{%- endblock -%}

{%- block content -%}
<main id="main-content">
  <div class="subscribe-wrap fade-in">
    <div class="subscribe-mark">Field Notes</div>
    <p class="subscribe-tagline">Working it out before I have the answers.</p>
    <form class="subscribe-form" id="subscribeForm">
      <input class="subscribe-input" type="email" id="subEmail" required placeholder="Your email" aria-label="Email address">
      <button class="subscribe-btn" type="submit" id="subBtn">Subscribe</button>
    </form>
    <div class="subscribe-success" id="subSuccess">You&rsquo;re in. Check your inbox.</div>
    <div class="subscribe-error" id="subError">Something went wrong. Try again.</div>
  </div>
  <div class="subscribe-recent fade-in">
    <div class="subscribe-recent-label">Recent essays</div>
    {%- set count = 0 -%}
    {%- for post in collections.essays -%}
      {%- if count < 3 and post.data.assessmentCallout -%}
        <div class="subscribe-recent-item">
          <a href="{{ post.data.permalink }}"><span class="subscribe-recent-arrow">&rarr;</span>{{ post.data.title }}</a>
        </div>
        {%- set count = count + 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</main>
{%- endblock -%}

{%- block subscribe -%}
<div class="signup-section fade-in">
  <h2 style="font-family: var(--sans); font-size: 0.85rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem;">The Field Assessment</h2>
  <p style="font-family: var(--serif); font-size: 1.05rem; color: rgba(255,255,255,0.8); margin-bottom: 1.75rem; max-width: 420px; margin-left: auto; margin-right: auto; line-height: 1.7;">Eighteen questions. Five minutes. Two parts. What you&rsquo;re carrying into the room. What the room is doing with it.</p>
  <a class="cta-btn" href="/field-assessment/" style="background: var(--white); color: var(--black); border-color: var(--white);">Take the Assessment</a>
</div>
{%- endblock -%}

<script>
document.getElementById('subscribeForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email = document.getElementById('subEmail').value.trim();
  const btn = document.getElementById('subBtn');
  if (!email) return;
  btn.textContent = '...';
  btn.disabled = true;
  try {
    const res = await fetch('/.netlify/functions/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    if (res.ok) {
      document.getElementById('subscribeForm').style.display = 'none';
      document.getElementById('subSuccess').style.display = 'block';
    } else {
      document.getElementById('subError').style.display = 'block';
      btn.textContent = 'Subscribe';
      btn.disabled = false;
    }
  } catch(err) {
    document.getElementById('subError').style.display = 'block';
    btn.textContent = 'Subscribe';
    btn.disabled = false;
  }
});
</script>
