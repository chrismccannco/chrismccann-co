---
title: "Subscribe — Field Notes"
description: "Field Notes by Chris McCann. Consciousness, leadership, and the gap between them. Two essays a month."
permalink: /subscribe/index.html
---
{%- extends "base.njk" -%}

{%- block head -%}
<style>
  .subscribe-wrap {
    max-width: 480px;
    margin: 0 auto;
    padding: 4rem 2rem 5rem;
    text-align: center;
  }
  .subscribe-mark {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .subscribe-title {
    font-family: var(--sans);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--black);
    margin-bottom: 0.75rem;
  }
  .subscribe-tagline {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--gray);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }
  .subscribe-note {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--light-gray);
    letter-spacing: 0.02em;
    margin-bottom: 2.5rem;
  }
  .subscribe-form {
    display: flex;
    gap: 0;
    max-width: 380px;
    width: 100%;
    margin: 0 auto 1rem;
  }
  .subscribe-input {
    flex: 1;
    padding: 13px 16px;
    font-family: var(--sans);
    font-size: 0.9rem;
    border: 1px solid var(--light-gray);
    border-right: none;
    background: #fff;
    color: var(--black);
    outline: none;
    min-width: 0;
    transition: border-color 0.2s ease;
  }
  .subscribe-input:focus {
    border-color: var(--accent);
  }
  .subscribe-btn {
    padding: 13px 24px;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--black);
    color: var(--white);
    border: 1px solid var(--black);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .subscribe-btn:hover { opacity: 0.8; }
  .subscribe-success {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--accent);
    margin-top: 0.75rem;
    display: none;
  }
  .subscribe-error {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: #c0392b;
    margin-top: 0.75rem;
    display: none;
  }
  .subscribe-divider {
    border: none;
    border-top: 1px solid var(--light-gray);
    margin: 3rem auto;
    max-width: 48px;
  }
  .subscribe-archive {
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--gray);
    font-style: italic;
  }
  .subscribe-archive a {
    color: var(--gray);
    text-decoration: none;
    border-bottom: 1px solid var(--light-gray);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .subscribe-archive a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
{%- endblock -%}

{%- block header -%}{%- endblock -%}

{%- block content -%}
<main id="main-content">
  <div class="subscribe-wrap fade-in">
    <div class="subscribe-mark">Field Notes</div>
    <h1 class="subscribe-title">Stay in it.</h1>
    <p class="subscribe-tagline">Consciousness. Leadership. The gap between them.</p>
    <p class="subscribe-note">Two essays a month. No noise. Unsubscribe any time.</p>

    <form class="subscribe-form" id="subscribeForm">
      <input
        class="subscribe-input"
        type="email"
        id="subEmail"
        required
        placeholder="Your email"
        aria-label="Email address"
      >
      <button class="subscribe-btn" type="submit" id="subBtn">Subscribe</button>
    </form>
    <div class="subscribe-success" id="subSuccess">You&rsquo;re in. Check your inbox.</div>
    <div class="subscribe-error" id="subError">Something went wrong. Try again.</div>

    <hr class="subscribe-divider">

    <p class="subscribe-archive">
      <a href="/field-notes/">Browse all essays &rarr;</a>
    </p>
  </div>
</main>subscribe.njk
{%- endblock -%}

{%- block subscribe -%}{%- endblock -%}

<script>
document.getElementById('subscribeForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email = document.getElementById('subEmail').value.trim();
  const btn = document.getElementById('subBtn');
  if (!email) return;
  btn.textContent = '...';
  btn.disabled = true;
  try {
    const res = await fetch('/.netlify/functions/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    if (res.ok) {
      document.getElementById('subscribeForm').style.display = 'none';
      document.getElementById('subSuccess').style.display = 'block';
    } else {
      document.getElementById('subError').style.display = 'block';
      btn.textContent = 'Subscribe';
      btn.disabled = false;
    }
  } catch(err) {
    document.getElementById('subError').style.display = 'block';
    btn.textContent = 'Subscribe';
    btn.disabled = false;
  }
});
</script>
