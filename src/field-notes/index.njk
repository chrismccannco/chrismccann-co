---
layout: false
title: "Field Notes — Chris McCann"
description: "Observations on consciousness, leadership, and what happens in the room when the two meet."
ogDescription: "The room shifts when you walk in. You know this. What the quarterly review doesn't measure."
canonicalUrl: "/field-notes/"
permalink: /field-notes/index.html
---
{%- extends "base.njk" -%}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Field Notes by Chris McCann",
  "url": "https://chrismccann.co/field-notes",
  "description": "The room shifts when you walk in. You know this. What the quarterly review doesn't measure.",
  "author": { "@type": "Person", "name": "Chris McCann", "url": "https://chrismccann.co" }
}
</script>
{% endblock %}

{% block pagestyle %}
<style>
  .fn-body { max-width: 1280px; margin: 0 auto; padding: 56px var(--px) 96px; }
  .fn-spotlight { border-left: 2px solid var(--rust); padding: 16px 0 16px 20px; margin-bottom: 56px; }
  .fn-spot-lbl { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: var(--faint); margin-bottom: 8px; }
  .fn-spot-link { font-size: 22px; font-weight: 400; color: var(--ink); transition: color .15s; }
  .fn-spot-link:hover { color: var(--rust); }
  .fn-section { margin-bottom: 64px; }
  .fn-sec-head { border-bottom: 1px solid var(--ink); padding-bottom: 14px; display: flex; align-items: baseline; justify-content: space-between; }
  .fn-sec-title { font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: .16em; text-transform: uppercase; font-weight: 500; }
  .fn-sec-sub { font-size: 15px; color: var(--faint); font-weight: 300; padding: 18px 0 28px; max-width: 600px; }
  .fn-article { display: grid; grid-template-columns: 88px 1fr; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--line); color: var(--ink); transition: padding-left .2s; }
  .fn-article:hover { padding-left: 8px; }
  .fn-date { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--faint); padding-top: 5px; }
  .fn-art-title { font-size: 26px; font-weight: 400; margin-bottom: 8px; display: block; }
  .fn-art-excerpt { font-size: 16px; line-height: 1.6; color: var(--muted); font-weight: 300; }
  @media (max-width: 860px) {
    .fn-body { padding: 40px var(--px) 64px; }
    .fn-article { grid-template-columns: 1fr; gap: 8px; }
    .fn-art-title { font-size: 22px; }
  }
</style>
{% endblock %}

{% block content %}
<div class="ph">
  <div class="ph-eye">Field Notes</div>
  <h1 class="ph-title">Dispatches from the work</h1>
  <p class="ph-sub">Observations on consciousness, leadership, and what happens in the room when the two meet.</p>
</div>
<hr class="ph-rule">

<div class="fn-body">
  {% set latest = collections.essays | first %}
  <div class="fn-spotlight">
    <div class="fn-spot-lbl">Latest</div>
    <a href="{{ latest.url }}" class="fn-spot-link">{{ latest.data.title }} &rarr;</a>
  </div>

  <div class="fn-section">
    <div class="fn-sec-head">
      <div class="fn-sec-title">All Notes</div>
    </div>
    {% for post in collections.essays %}
    <a href="{{ post.url }}" class="fn-article">
      <div class="fn-date">{{ post.data.date | monthYear }}</div>
      <div>
        <span class="fn-art-title">{{ post.data.title }}</span>
        <div class="fn-art-excerpt">{{ post.data.description }}</div>
      </div>
    </a>
    {% endfor %}
  </div>
</div>
{% endblock %}

{% block subscribe %}
<div class="sub-band">
  <div class="sub-band-inner">
    <h2>Field Notes Newsletter</h2>
    <p>Twice a month. Consciousness and leadership. The gap between what you do and what you&rsquo;re carrying when you do it.</p>
    <form class="sub-form" id="subBandForm" novalidate>
      <input type="email" id="bandEmail" placeholder="you@work.com" aria-label="Email address" required>
      <button type="submit" id="bandBtn">I&rsquo;M IN</button>
    </form>
    <div class="sub-success" id="bandSuccess">You&rsquo;re in. Check your inbox.</div>
    <div class="sub-error" id="bandError">Something went wrong &mdash; try again.</div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('subBandForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  const email = document.getElementById('bandEmail').value.trim();
  const btn = document.getElementById('bandBtn');
  if (!email) return;
  btn.textContent = '...';
  btn.disabled = true;
  try {
    const res = await fetch('/.netlify/functions/subscribe', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email })
    });
    if (res.ok) {
      document.getElementById('subBandForm').style.display = 'none';
      document.getElementById('bandSuccess').style.display = 'block';
    } else {
      document.getElementById('bandError').style.display = 'block';
      btn.textContent = 'I’M IN'; btn.disabled = false;
    }
  } catch (err) {
    document.getElementById('bandError').style.display = 'block';
    btn.textContent = 'I’M IN'; btn.disabled = false;
  }
});
</script>
{% endblock %}
